{
  "name": "earworm-m0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/build-wasm.sh --if-available && vite web",
    "dev:nocoi": "EARWORM_NO_COI=1 vite web",
    "build": "vite build web",
    "build:wasm": "sh scripts/build-wasm.sh",
    "test": "vitest run --root web && cargo test --workspace",
    "typecheck": "tsc -p web --noEmit",
    "gen:params": "node tools/paramgen/paramgen.ts",
    "gen:demo": "WRITE_DEMO=1 vitest run --root web src/m1/demo.test.ts"
  },
  "devDependencies": {
    "@types/audioworklet": "0.0.102",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
